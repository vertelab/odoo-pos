                            <field name="unit_id"/>
                            <field name="sales_date"/>
                            <field name="produced_at"/>
                        </group>
                    </group>
                    <group>
                        <group string="Försäljning">
                            <field name="total_sales"/>
                            <field name="receipt_count"/>
                            <field name="return_count"/>
                        </group>
                        <group string="Kassalåda">
                            <field name="cash_register_balance_start"/>
                            <field name="cash_register_balance_end"/>
                            <field name="drawer_open_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Betalningsmedel" name="payment">
                            <field name="line_ids"
                                   domain="[('line_type','=','payment')]"
                                   readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="amount" sum="Summa"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Momsfördelning" name="tax">
                            <field name="line_ids"
                                   domain="[('line_type','=','tax')]"
                                   readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="rate"/>
                                    <field name="amount" sum="Summa"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <field name="currency_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pos_report_x" model="ir.actions.act_window">
        <field name="name">X-dagrapporter</field>
        <field name="res_model">pos.report.x</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
