    <template id="report_pos_report_x">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="pos_kassaregister_se.report_pos_report_x_document"/>
            </t>
        </t>
    </template>

</odoo>
