<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_journal_export_wizard_form" model="ir.ui.view">
        <field name="name">pos.journal.export.wizard.form</field>
        <field name="model">pos.journal.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Exportera journalminne">
                <p class="text-muted">
                    Exporten följer SKVFS 2021:16 och valideras mot
                    Skatteverkets schema innan filen skapas. En fil som inte
                    validerar levereras aldrig.
                </p>
                <group>
                    <field name="unit_ids" widget="many2many_tags"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_export" type="object"
                            string="Exportera" class="btn-primary"/>
                    <button special="cancel" string="Avbryt" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pos_journal_export_wizard" model="ir.actions.act_window">
        <field name="name">Exportera journalminne</field>
        <field name="res_model">pos.journal.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
