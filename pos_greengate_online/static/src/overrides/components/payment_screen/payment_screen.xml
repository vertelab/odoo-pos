<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.PaymentScreenValidate" t-inherit-mode="extension">
        <xpath expr="//button" position="attributes">
            <attribute name="t-att-disabled">greenGateUi.isSigning or !currentOrder.canBeValidated()</attribute>
            <attribute name="t-attf-class">
                validation-button next btn btn-primary btn-lg py-3 lh-lg
                {{ ui.isSmall ? 'btn-switchpane flex-fill' : 'button next w-50' }}
                {{ currentOrder.canBeValidated() and !greenGateUi.isSigning ? 'highlight' : 'disabled' }}
            </attribute>
        </xpath>
        <xpath expr="//button/span" position="replace">
            <span t-if="greenGateUi.isSigning">Getting signature...</span>
            <span t-else="">Validate</span>
        </xpath>
        <xpath expr="//button" position="after">
            <div
                t-if="greenGateUi.isSigning"
                class="small text-muted text-center mt-2"
            >
                Waiting for GreenGate before finalizing this payment.
            </div>
        </xpath>
    </t>
</templates>
