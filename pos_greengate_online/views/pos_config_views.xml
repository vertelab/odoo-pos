<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_form_greengate" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.greengate.online</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='title']" position="after">

                <div class="row mt16 o_settings_container">

                    <!-- Block 1: Connection -->
                    <setting string="GreenGate Integration"
                             help="Enable GreenGate fiscal integration for this Point of Sale">
                        <field name="use_greengate"/>
                        <div class="content-group mt16" invisible="not use_greengate">
                            <div class="row mt8">
                                <div class="col-lg-4 o_light_label">
                                    <label for="greengate_mode" string="Mode"/>
                                </div>
                                <div class="col-lg-8">
                                    <field name="greengate_mode"/>
                                </div>
                            </div>
                            <!--<div class="row mt8">
                                <div class="col-lg-4 o_light_label">
                                    <label for="greengate_url" string="URL"/>
                                </div>
                                <div class="col-lg-8">
                                    <field name="greengate_url"
                                           placeholder="https://greengateonline.origum.se/xccsp"/>
                                </div>
                            </div>
                            -<div class="row mt8">
                                <div class="col-lg-4 o_light_label">
                                    <label for="greengate_test_url" string="Test URL"/>
                                </div>
                                <div class="col-lg-8">
                                    <field name="greengate_test_url"
                                           placeholder="https://greengateonline.origum.se/xccsp"/>
                                </div>
                            </div>-->
                            <div class="row mt8">
                                <div class="col-lg-4 o_light_label">
                                    <label for="greengate_username" string="Username"/>
                                </div>
                                <div class="col-lg-8">
                                    <field name="greengate_username"/>
                                </div>
                            </div>
                            <div class="row mt8">
                                <div class="col-lg-4 o_light_label">
                                    <label for="greengate_password" string="Password"/>
                                </div>
                                <div class="col-lg-8">
                                    <field name="greengate_password" password="True"/>
                                </div>
                            </div>
                        </div>
                    </setting>

                    <!-- Block 2: POS Identity & Counters (only visible when GreenGate is enabled) -->
                    <setting string="GreenGate POS Identity"
                             help="Counters and identifiers used in GreenGate fiscal receipts"
                             invisible="not use_greengate">
                        <div class="content-group">
                            <div class="row mt8">
                                <div class="col-lg-4 o_light_label">
                                    <label for="greengate_serial_no" string="Global SerialNo Counter"/>
                                </div>
                                <div class="col-lg-8">
                                    <field name="greengate_serial_no"/>
                                </div>
                            </div>
                            <div class="row mt8">
                                <div class="col-lg-4 o_light_label">
                                    <label for="greengate_receipt_id" string="Global ReceiptNo Counter"/>
                                </div>
                                <div class="col-lg-8">
                                    <field name="greengate_receipt_id"/>
                                </div>
                            </div>
                            <div class="row mt8">
                                <div class="col-lg-4 o_light_label">
                                    <label for="greengate_pos_id" string="POS ID"/>
                                </div>
                                <div class="col-lg-8">
                                    <field name="greengate_pos_id" placeholder="e.g. PosA or 01"/>
                                </div>
                            </div>
                            <div class="row mt8">
                                <div class="col-lg-4 o_light_label">
                                    <label for="greengate_pos_id_full" string="Full POS ID (PosId + OrgNo)"/>
                                </div>
                                <div class="col-lg-8">
                                    <field name="greengate_pos_id_full" readonly="1"/>
                                </div>
                            </div>
                        </div>
                    </setting>

                </div>

            </xpath>
        </field>
    </record>
</odoo>